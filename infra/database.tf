# ============================================================================
# 数据库资源配置
# ============================================================================
#
# 说明：由于华为云账号限制（规格代码无效），以下数据库资源需要在控制台手动创建
#

# ============================================================================
# RDS MySQL 配置参考（手动创建）
# ============================================================================
# 手动创建路径：云数据库 RDS -> 实例管理 -> 创建实例
#
# 推荐配置：
#   - 实例类型：单机
#   - 规格：选择可用的最低规格（如 rds.mysql.s2.large）
#   - 存储类型：CLOUDSSD 或 LOCALSSD
#   - 存储空间：20GB
#   - 数据库版本：8.0
#   - VPC/子网/安全组：使用已创建的电商平台资源

# ============================================================================
# GeminiDB 配置参考（手动创建）
# ============================================================================
# 手动创建路径：GaussDB(for Mongo) -> 实例管理 -> 创建实例
#
# 推荐配置：
#   - 实例类型：单机
#   - 选择可用的最低规格
#   - 存储空间：20GB
#   - VPC/子网/安全组：使用已创建的电商平台资源

# ============================================================================
# 输出
# ============================================================================

output "mysql_endpoint" {
  value = "需手动创建后填写"
}

output "mysql_port" {
  value = 3306
}

output "mongodb_endpoint" {
  value = "需手动创建后填写"
}

output "mongodb_port" {
  value = 8635
}
